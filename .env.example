# ============================================================
# FastBox 环境变量示例文件
#
# 使用方法：
#   1. 复制本文件为 .env       （cp .env.example .env）
#   2. 按需取消注释并填写
#   3. docker compose up -d
#
# 说明：所有配置都可以在网页端 http://<IP>:8088 修改，
#       网页配置优先级高于本文件，且无需重启容器。
#       本文件主要用于「首次启动前」预置默认值。
# ============================================================

# ---------------- 服务基础 ----------------
PORT=8088
TZ=Asia/Shanghai

# ---------------- 首页与体验 ----------------
# douban(豆瓣热播首页) | lite(极速纯搜) | full(全能离线套件)
DEFAULT_HOME=douban
ENABLE_IMG_PROXY=true
ENABLE_DANMU=true

# ---------------- 搜索性能 ----------------
# 单源超时熔断(秒)：越小响应越快，推荐 2.5~3.5
SEARCH_TIMEOUT=3.0
MAX_CONCURRENCY=20
CACHE_TTL_SEARCH=1800
CACHE_TTL_DOUBAN=7200

# ---------------- ① pansou-edge 网盘聚合搜索 ----------------
# 自建 pansou / pansou-edge 服务地址（结尾不要带斜杠）。留空则使用内置公开节点。
# 参考项目：https://github.com/dszz453/pansou-edge
#
# 支持填多个地址（英文逗号或分号分隔），会并行竞速、互为兜底：
# 先返回非空结果者胜出，任一可用就不会出现「网盘一条都搜不到」。
# 同机容器可直接写容器名，例如：
#   PANSOU_EDGE_URL=http://pansou-app:80,https://pansou.yourdomain.workers.dev
ENABLE_PANSOU_EDGE=true
PANSOU_EDGE_URL=
PANSOU_EDGE_TOKEN=
PANSOU_EDGE_TIMEOUT=4.0

# ---------------- ② PanCheck 网盘死链检测 ----------------
# 自建 PanCheck 服务地址，例如 http://192.168.1.10:8774
# 参考项目：https://github.com/Lampon/PanCheck
# 检测模式: auto(默认) | remote(强制远程) | local(强制内置) | off(关闭)
PANCHECK_MODE=auto
PANCHECK_URL=
PANCHECK_TIMEOUT=1.5
PANCHECK_BATCH_SIZE=30
# 单次搜索最多探活多少条链接（0 = 不检测）。
# 网盘站探活较慢，调大能过滤更多死链但会拖慢响应，推荐 20~40。
PANCHECK_MAX_LINKS=30

# ---------------- ③ 网盘播放密钥（推荐用网页扫码配置） ----------------
# 推荐：打开网页 → 「🔑 网盘密钥」→ 扫码授权登录（阿里云盘支持真正的扫码登录）
# 下面的环境变量仅作为「不想用网页」时的预置手段，容器启动时会写入 tokenm.json

# 阿里云盘
# ALI_OPEN_TOKEN=
# ALI_TOKEN=
# 阿里云盘 open_token 兑换接口（扫码登录后自动调用，一般无需修改）
# ALI_OPEN_API_URL=http://api.extscreen.com/aliyundrive/token

# 夸克网盘
# QUARK_COOKIE=
# QUARK_IS_GUEST=false

# UC 网盘
# UC_COOKIE=

# 115 网盘
# YD_AUTH=

# 迅雷网盘
# THUNDER_USERNAME=
# THUNDER_PASSWORD=
# THUNDER_CAPTCHA_TOKEN=

# PikPak
# PIKPAK_USERNAME=
# PIKPAK_PASSWORD=

# ---------------- 播放偏好 ----------------
# 画质偏好：4kz(4K优先) | auto(自动)
VOD_FLAGS=4kz|auto
VIP_THREAD_LIMIT=32
QUARK_THREAD_LIMIT=32
UC_THREAD_LIMIT=10
THUNDER_THREAD_LIMIT=2
